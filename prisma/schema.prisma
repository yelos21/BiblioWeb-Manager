// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NombreRol {
  ADMINISTRADOR
  MOSTRADOR
  INVENTARIO
 
  @@map("nombre_rol")
}
 
enum EstadoFisico {
  NUEVO
  BUENO
  REGULAR
  DETERIORADO
 
  @@map("estado_fisico")
}
 
enum EstadoEjemplar {
  DISPONIBLE
  PRESTADO
  EN_REPARACION
  BAJA
 
  @@map("estado_ejemplar")
}
 
enum EstadoMulta {
  PENDIENTE
  PAGADA
  CONDONADA
 
  @@map("estado_multa")
}
 
enum TipoReporte {
  SISTEMA
  OPERACION
 
  @@map("tipo_reporte")
}
 

 // Better auth tablas

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
 
  // Campos que agrega el plugin admin
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
 
  sessions Session[]
  accounts Account[]
  usuario  Usuario?
 
  @@map("user")
}
 
model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String? // plugin admin
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@index([userId])
  @@map("session")
}
 
// La contrasena del personal se guarda aqui en password, no en Usuario
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@index([userId])
  @@map("account")
}
 
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
 
  @@index([identifier])
  @@map("verification")
}
 
// roles de biblioweb

 
model Rol {
  id     Int       @id @default(autoincrement()) @map("id_rol") @db.SmallInt
  nombre NombreRol @unique
 
  usuarios Usuario[]
  permisos RolPermiso[]
 
  @@map("rol")
}
 
model Permiso {
  id          Int     @id @default(autoincrement()) @map("id_permiso") @db.SmallInt
  codigo      String  @unique @db.VarChar(40)
  descripcion String  @db.VarChar(150)
  esGlobal    Boolean @default(false) @map("es_global")
 
  roles    RolPermiso[]
  usuarios UsuarioPermiso[]
 
  @@map("permiso")
}
 
// Permisos base de cada rol 
model RolPermiso {
  idRol     Int @map("id_rol") @db.SmallInt
  idPermiso Int @map("id_permiso") @db.SmallInt
 
  rol     Rol     @relation(fields: [idRol], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [idPermiso], references: [id], onDelete: Cascade)
 
  @@id([idRol, idPermiso])
  @@index([idPermiso])
  @@map("rol_permiso")
}
 
// Perfil del personal. Nombre, correo, contrasena y bloqueo estan en User.
model Usuario {
  id            Int      @id @default(autoincrement()) @map("id_usuario")
  idAuth        String   @unique @map("id_auth")
  idRol         Int      @map("id_rol") @db.SmallInt
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
 
  auth User @relation(fields: [idAuth], references: [id])
  rol  Rol  @relation(fields: [idRol], references: [id])
 
  permisos             UsuarioPermiso[]
  clientesRegistrados  Cliente[]
  prestamosRegistrados Prestamo[]       // Prestamo "registra" Usuario
  devolucionesRecibidas Devolucion[]    // Devolucion "recibe" Usuario
  multasCalculadas     Multa[]          // Multa "calcula" Usuario
  sancionesAplicadas   Sancion[]        // Sancion "aplica" Usuario
  reportes             Reporte[]
  auditorias           Auditoria[]
 
  @@index([idRol])
  @@map("usuario")
}
 
// Permisos reales de cada usuario
model UsuarioPermiso {
  idUsuario Int @map("id_usuario")
  idPermiso Int @map("id_permiso") @db.SmallInt
 
  usuario Usuario @relation(fields: [idUsuario], references: [id])
  permiso Permiso @relation(fields: [idPermiso], references: [id], onDelete: Cascade)
 
  @@id([idUsuario, idPermiso])
  @@index([idPermiso])
  @@map("usuario_permiso")
}
 

// Catalogo de biblioteca

model Editorial {
  id     Int     @id @default(autoincrement()) @map("id_editorial")
  nombre String  @unique @db.VarChar(100)
  pais   String? @db.VarChar(60)
 
  libros Libro[]
 
  @@map("editorial")
}
 
model Categoria {
  id          Int     @id @default(autoincrement()) @map("id_categoria")
  nombre      String  @unique @db.VarChar(80)
  descripcion String?
 
  libros Libro[]
 
  @@map("categoria")
}
 
model Autor {
  id           Int     @id @default(autoincrement()) @map("id_autor")
  nombre       String  @db.VarChar(120)
  nacionalidad String? @db.VarChar(60)
 
  libros LibroAutor[]
 
  @@map("autor")
}
 
model Libro {
  id              Int     @id @default(autoincrement()) @map("id_libro")
  isbn            String  @unique @db.VarChar(20)
  titulo          String  @db.VarChar(200)
  anioPublicacion Int?    @map("anio_publicacion") @db.SmallInt
  descripcion     String?
  idEditorial     Int     @map("id_editorial")
  idCategoria     Int     @map("id_categoria")
 
  editorial Editorial @relation(fields: [idEditorial], references: [id])
  categoria Categoria @relation(fields: [idCategoria], references: [id])
  autores   LibroAutor[]
  ejemplares Ejemplar[]
 
  @@index([idEditorial])
  @@index([idCategoria])
  @@map("libro")
}
 
model LibroAutor {
  idLibro Int @map("id_libro")
  idAutor Int @map("id_autor")
 
  libro Libro @relation(fields: [idLibro], references: [id], onDelete: Cascade)
  autor Autor @relation(fields: [idAutor], references: [id])
 
  @@id([idLibro, idAutor])
  @@index([idAutor])
  @@map("libro_autor")
}
 
model Ejemplar {
  id               Int            @id @default(autoincrement()) @map("id_ejemplar")
  idLibro          Int            @map("id_libro")
  codigoInventario String         @unique @map("codigo_inventario") @db.VarChar(30)
  ubicacion        String?        @db.VarChar(60)
  estadoFisico     EstadoFisico   @default(BUENO) @map("estado_fisico")
  estado           EstadoEjemplar @default(DISPONIBLE)
  fechaAdquisicion DateTime       @default(now()) @map("fecha_adquisicion") @db.Date
  motivoBaja       String?        @map("motivo_baja")
 
  libro     Libro      @relation(fields: [idLibro], references: [id])
  prestamos Prestamo[]
 
  @@index([idLibro])
  @@map("ejemplar")
}
 
// clientes y prestamos

model Cliente {
  id                Int      @id @default(autoincrement()) @map("id_cliente")
  credencial        Int      @unique @default(autoincrement())
  identificacion    String   @unique @db.VarChar(30)
  nombre            String   @db.VarChar(100)
  email             String   @db.VarChar(120)
  telefono          String?  @db.VarChar(20)
  direccion         String?  @db.VarChar(200)
  fechaRegistro     DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(6)
  idUsuarioRegistro Int      @map("id_usuario_registro")
 
  registradoPor Usuario    @relation(fields: [idUsuarioRegistro], references: [id])
  prestamos     Prestamo[]
  sanciones     Sancion[]
 
  @@index([idUsuarioRegistro])
  @@map("cliente")
}
 

model Prestamo {
  id                Int       @id @default(autoincrement()) @map("id_prestamo")
  idCliente         Int       @map("id_cliente")
  idEjemplar        Int       @map("id_ejemplar")
  idUsuarioRegistra Int       @map("id_usuario_registra")
  idRegla           Int       @map("id_regla") @db.SmallInt
  fechaPrestamo     DateTime  @default(now()) @map("fecha_prestamo") @db.Timestamptz(6)
  fechaVencimiento  DateTime  @map("fecha_vencimiento") @db.Date
  // La fija el trigger al registrar la Devolucion (ver extras.sql)
  fechaDevolucion   DateTime? @map("fecha_devolucion") @db.Timestamptz(6)
 
  cliente       Cliente       @relation(fields: [idCliente], references: [id])
  ejemplar      Ejemplar      @relation(fields: [idEjemplar], references: [id])
  registradoPor Usuario       @relation(fields: [idUsuarioRegistra], references: [id])
  regla         ReglaPrestamo @relation(fields: [idRegla], references: [id])
  devolucion    Devolucion?
 
  @@index([idCliente])
  @@index([idEjemplar])
  @@index([idUsuarioRegistra])
  @@index([idRegla])
  @@map("prestamo")
}
 
model Devolucion {
  id                    Int          @id @default(autoincrement()) @map("id_devolucion")
  idPrestamo            Int          @unique @map("id_prestamo")
  idUsuarioRecibe       Int          @map("id_usuario_recibe")
  fecha                 DateTime     @default(now()) @db.Timestamptz(6)
  estadoFisicoAlRecibir EstadoFisico @map("estado_fisico_al_recibir")
  observaciones         String?
 
  prestamo   Prestamo @relation(fields: [idPrestamo], references: [id])
  recibidaPor Usuario @relation(fields: [idUsuarioRecibe], references: [id])
  multa      Multa?
 
  @@index([idUsuarioRecibe])
  @@map("devolucion")
}
 

model Multa {
  id               Int         @id @default(autoincrement()) @map("id_multa")
  idDevolucion     Int         @unique @map("id_devolucion")
  idUsuarioCalcula Int         @map("id_usuario_calcula")
  diasRetraso      Int         @map("dias_retraso")
  monto            Decimal     @db.Decimal(10, 2)
  estado           EstadoMulta @default(PENDIENTE)
  fechaGeneracion  DateTime    @default(now()) @map("fecha_generacion") @db.Timestamptz(6)
  fechaPago        DateTime?   @map("fecha_pago") @db.Timestamptz(6)
 
  devolucion Devolucion @relation(fields: [idDevolucion], references: [id])
  calculadaPor Usuario  @relation(fields: [idUsuarioCalcula], references: [id])
  sancion    Sancion?
 
  @@index([idUsuarioCalcula])
  @@map("multa")
}
 

model Sancion {
  id              Int       @id @default(autoincrement()) @map("id_sancion")
  idCliente       Int       @map("id_cliente")
  idMulta         Int?      @unique @map("id_multa")
  idUsuarioAplica Int       @map("id_usuario_aplica")
  motivo          String
  fechaInicio     DateTime  @default(now()) @map("fecha_inicio") @db.Date
  fechaFin        DateTime  @map("fecha_fin") @db.Date
  fechaLevantada  DateTime? @map("fecha_levantada") @db.Date
 
  cliente   Cliente @relation(fields: [idCliente], references: [id])
  multa     Multa?  @relation(fields: [idMulta], references: [id])
  aplicadaPor Usuario @relation(fields: [idUsuarioAplica], references: [id])
 
  @@index([idCliente])
  @@index([idUsuarioAplica])
  @@map("sancion")
}
 
 // configuracion
 
model ReglaPrestamo {
  id                      Int      @id @default(autoincrement()) @map("id_regla") @db.SmallInt
  diasPrestamo            Int      @map("dias_prestamo") @db.SmallInt
  maxPrestamosPorCliente  Int      @map("max_prestamos_por_cliente") @db.SmallInt
  multaPorDia             Decimal  @map("multa_por_dia") @db.Decimal(10, 2)
  diasSancionBase         Int      @map("dias_sancion_base") @db.SmallInt
  vigenteDesde            DateTime @default(now()) @map("vigente_desde") @db.Date
 
  prestamos Prestamo[]
 
  @@map("regla_prestamo")
}
 
model Reporte {
  id              Int         @id @default(autoincrement()) @map("id_reporte")
  idUsuario       Int         @map("id_usuario")
  tipo            TipoReporte
  periodoInicio   DateTime    @map("periodo_inicio") @db.Date
  periodoFin      DateTime    @map("periodo_fin") @db.Date
  fechaGeneracion DateTime    @default(now()) @map("fecha_generacion") @db.Timestamptz(6)
 
  usuario Usuario @relation(fields: [idUsuario], references: [id])
 
  @@index([idUsuario])
  @@map("reporte")
}
 
// Bitacora de acciones del personal 
model Auditoria {
  id         BigInt   @id @default(autoincrement()) @map("id_auditoria")
  idUsuario  Int      @map("id_usuario")
  accion     String   @db.VarChar(50)
  entidad    String   @db.VarChar(50)
  idRegistro Int?     @map("id_registro")
  fechaHora  DateTime @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  detalle    String?
 
  usuario Usuario @relation(fields: [idUsuario], references: [id])
 
  @@index([idUsuario, fechaHora])
  @@map("auditoria")
}